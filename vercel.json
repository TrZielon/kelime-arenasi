{
  "functions": {
    "api/claude.js": { "maxDuration": 60 },
    "api/news-update.js": { "maxDuration": 60 },
    "api/og-image.js": { "maxDuration": 15 }
  },
  "crons": [
    { "path": "/api/news-update", "schedule": "0 6 * * *" }
  ],
  "headers": [
    { "source": "/lib/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(svg|png|ico|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(ortak\\.css|ortak\\.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] }
  ]
}
